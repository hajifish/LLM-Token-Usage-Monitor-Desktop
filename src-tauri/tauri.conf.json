{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Local LLM Token Usage Monitor",
  "version": "0.2.18",
  "identifier": "com.hajifish.llm-token-monitor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Local LLM Token Usage Monitor",
        "width": 780,
        "height": 540,
        "resizable": false,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "theme": "Dark",
        "visible": false,
        "windowEffects": {
          "effects": ["hudWindow"],
          "state": "active"
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost data:; connect-src 'self' https://api.deepseek.com https://api.moonshot.cn https://open.bigmodel.cn https://api.openai.com https://api.anthropic.com https://platform.deepseek.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYyMkEwQzUyRUYwRjhCRjYKUldUMml3L3ZVZ3dxOGgyU3lqRUJsQ1I3VGFpRXpidDVxVmhsU2Y3TG9BeUZoRjdFUis2enpFV3EK",
      "endpoints": [
        "https://github.com/hajifish/Local-LLM-Token-Usage-Monitor-Desktop/releases/latest/download/latest.json"
      ]
    }
  }
}
