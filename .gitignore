# Dependencies
node_modules/

# Build output
dist/

# Tauri / Rust
src-tauri/target/
# 仓库根下的 Rust 构建缓存（rust-analyzer 等以根目录跑 cargo 时产生）
/target/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# 本地工具产物（Playwright MCP 会话日志等）
.playwright-mcp/

# 会话工作留痕（poteto-mode todo / 决策日志，本地产物不入库）
.audit/

# OS
.DS_Store
Thumbs.db

# Git worktrees（并行任务隔离工作区）
.worktrees/
.claude/worktrees/

# Environment
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*

# Tauri optional capabilities (auto-generated)
src-tauri/gen/

# TypeScript
*.tsbuildinfo

# Secrets / Keys
*.pem
*.key
*.p12
*.pfx
*.keystore
src-tauri/*.key

# verify 技能的运行证据（截图/控制台/快照，按 run 递增，本地留存不入库——
